# DPI/IDS/IPS Central Security Backend & Notification Configuration Template
# Copy this file to .env and configure local settings. Never commit secrets to git.

# FastAPI Backend Settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# DPI / IDS / IPS Pipeline Settings
DPI_INGESTION_MODE=live
DPI_INTERFACE=tnnl
DPI_BPF_FILTER=ip
DPI_ACTIVE_PREVENTION=false
ML_ENABLED=true
DPI_WORKERS=4
DPI_QUEUE_SIZE=10000
DPI_VPN_SUBNETS=10.100.0.0/24,10.8.0.0/24,10.10.0.0/24

# Security Email Notification Settings
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=ids-alerts@security.local
ALERT_EMAIL_TO=kanvav.ec23@bmsce.ac.in
EMAIL_COOLDOWN_SECONDS=300
EMAIL_NOTIFY_ON_ML=false

